{
  "manifest_version": 3,
  "name": "PII Firewall",
  "version": "0.1.0",
  "description": "Stops your SSN, card numbers, phone, email, address and name from being sent to AI chatbots. Runs 100% locally.",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_popup": "src/popup.html", "default_title": "PII Firewall" },
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*",
        "https://copilot.microsoft.com/*",
        "https://www.perplexity.ai/*",
        "https://chat.deepseek.com/*",
        "https://chat.mistral.ai/*",
        "https://poe.com/*",
        "https://grok.com/*"
      ],
      "js": ["lib/pii-core.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ]
}
